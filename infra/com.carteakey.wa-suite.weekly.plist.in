<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carteakey.wa-suite.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WA_SUITE_ROOT__/run.sh</string>
    <string>weekly</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DRY_RUN</key>
    <string>true</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/wa-suite-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/wa-suite-weekly.log</string>
</dict>
</plist>
