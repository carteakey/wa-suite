# Safe defaults: mutating commands and classifiers run as dry-runs.
DRY_RUN=true
MSG_LIMIT=2000
FORWARD_SCORE=5
CHATS=
GROUPS_ONLY=false

# Memento archival output (private local files; never commit real exports).
OUTPUT_DIR=~/Pictures/WhatsApp/incoming
OUTPUT_FILE=~/Documents/WhatsApp/starred.md
STATS_FORMAT=json
SCHEDULE_CHECKPOINT=./memento/whatsapp/schedule-progress.json
SEND_ONCE_PER_DAY=true
SKIP_FORWARDED=true

# Unforwarder cleanup controls (AGE_DAYS is required for delete-old).
AGE_DAYS=
MESSAGE_TYPES=
GROUP_PATTERNS=
MUTE_DAYS=
MUTE_CONFIRM=
LEAVE_CONFIRM=
INACTIVE_DAYS=

# Classifier controls.
SOURCE_FOLDER=~/Pictures/WhatsApp/incoming
OLLAMA_SERVER_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TEXT_MODEL=qwen3.5:9b
VIDEO_FFMPEG=ffmpeg
VIDEO_FRAME_COUNT=4
